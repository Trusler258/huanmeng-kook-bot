# .env — API 密钥（bot_config.toml 中 provider 的值决定读取哪个 KEY）
# 复制为 .env 并填入真实密钥

# KOOK Bot Token（在 https://developer.kookapp.cn/bot 创建 Bot 后获取）
# 也可在 bot_config.toml 的 [kook] 段配置
KOOK_KEY=

# DeepSeek
DEEPSEEK_KEY=sk-xxxxxxxx
DEEPSEEK_URL=https://api.deepseek.com

# SiliconFlow（如需）
SILICONFLOW_KEY=sk-xxxxxxxx
SILICONFLOW_URL=https://api.siliconflow.cn/v1

# 智谱（如需图片识别用）
ZHIPU_KEY=xxx
ZHIPU_URL=https://open.bigmodel.cn/api/paas/v4

# 基元律动 TokenRhythm（如需）
TOKENRHYTHM_KEY=sk_tr-xxxxxxxx
TOKENRHYTHM_URL=https://tokenrhythm.studio/v1
# .balance 余额查询用登录态（逆向接口，浏览器 DevTools 复制，含 tr_session；失效需重新复制）
TR_COOKIE=
# 或使用 Bearer token（二选一）
TR_TOKEN=
