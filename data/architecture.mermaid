        语言["utils/format_lang.py<br/>load_lang() lang.toml<br/>format_lang() ${var}<br/>点分路径取值"]
        用户名["utils/username.py<br/>get_or_resolve_username()<br/>replace_at_in_message()<br/>roles.toml预设<br/>本地缓存 在线WS<br/>三级查找用户名"]
